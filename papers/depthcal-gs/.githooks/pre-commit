#!/usr/bin/env bash
# Rebuild depthcal-gs.pdf whenever a manuscript source is part of the commit, and add it to the same commit.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^(main\.tex|sections/|figures/|refs/references\.bib|latexmkrc)'; then
  echo "pre-commit: manuscript sources changed, rebuilding depthcal-gs.pdf"
  scripts/build.sh
  git add depthcal-gs.pdf
fi
