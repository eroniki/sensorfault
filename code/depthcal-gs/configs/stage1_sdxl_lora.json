{
  "_comment": "Stage 1: supervised fine-tune of SDXL (frozen fp16 base + LoRA rank 32 + widened 8-channel conv_in) to sample affine-invariant depth from RGB. Paths come from the environment: SDXL_DIR, BLENDEDMVS_ROOT, HYPERSIM_ROOT (and HYPERSIM_SPLIT_CSV). ETH3D is never read.",
  "pretrained": "${SDXL_DIR}",
  "embeds_cache": "${STAGE1_WORK}/empty_prompt_embeds.pt",
  "vae": "fp32",
  "prediction_type": "v_prediction",
  "zero_snr": true,
  "rank": 32,
  "grad_ckpt": true,
  "res": 512,
  "micro_batch": 4,
  "accum": 8,
  "total_steps": 10000,
  "lr": 0.0001,
  "lr_conv": 0.00003,
  "warmup": 500,
  "cosine": true,
  "min_lr_frac": 0.05,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "init_scale": 4096,
  "max_consecutive_bad": 10,
  "workers": 8,
  "seed": 0,
  "log_every": 10,
  "ckpt_every_min": 90,
  "ckpt_every_steps": 500,
  "keep_last": 3,
  "milestone_every": 2000,
  "eval_every": 500,
  "val_samples": 32,
  "val_sample_images": 8,
  "val_ddim_steps": 10,
  "datasets": [
    {"type": "blendedmvs", "root": "${BLENDEDMVS_ROOT}", "weight": 0.6, "val_scenes": 6},
    {"type": "hypersim", "root": "${HYPERSIM_ROOT}", "weight": 0.4, "split_csv": "${HYPERSIM_SPLIT_CSV}"}
  ]
}
